# SLEIGH specification for the legacy 32-bit ARC instruction set (ARCtangent-A4 and the earlier
# ARC basecase cores; binutils calls it "arc"), shared by ARC32_le.slaspec and ARC32_be.slaspec.
#
# Originally written by cyrozap (Ghidra pull request #3233, Apache License 2.0). Reworked by
# Ghidra-Rare after differential testing against GNU binutils 2.25.1 (the last release with this
# target) and the ARCtangent-A4 Programmer's Reference (ARC International, 5050-001, 2002); see
# CREDITS.md for the list of changes.
#
# Instruction words are 32 bits, optionally followed by a 32-bit long immediate (limm). Syntax
# follows objdump 2.25.1: condition names z/nz/p/n/c/nc/v/nv, ".f" before the delay-slot mode,
# "0" for a discarded destination, mov/asl/rlc for and/add/adc with equal source operands.

define alignment=4;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

# Auxiliary registers, addressed by register number (32-bit words; instructions lr and sr)
define space auxregs type=ram_space size=4 wordsize=4;

# Core register set. r26-r31 have the binutils names; r57-r59 are MLO/MMID/MHI of the optional
# 32x32 multiplier; r60 is LP_COUNT; 61-63 are the immediate-data indicators (never registers).
define register offset=0 size=4 [
	 r0  r1  r2  r3  r4  r5  r6  r7  r8  r9 r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25  gp  fp  sp ilink1 ilink2 blink
	r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47
	r48 r49 r50 r51 r52 r53 r54 r55 r56 r57 r58 r59 lp_count r61 r62 r63
];

# STATUS register bits: condition flags Z N C V, interrupt enables E1 E2, halt bit H
define register offset=0x200 size=1 [ Z N C V E1 E2 H ];

# Set by lp (the zero-overhead loop is active); destination of discarded results
define register offset=0x210 size=1 [ is_in_loop ];
define register offset=0x220 size=4 [ discard contextreg pc ];

define context contextreg
	phase     = (0, 0)
	loopEnd   = (1, 1) noflow   # this instruction is at LP_END of a loop set up by lp
	loopStart = (2, 31) noflow  # LP_START / 4 of that loop
;

define token instr(32)
	I    = (27, 31)
	A    = (21, 26)
	Ar   = (21, 26)
	B    = (15, 20)
	Br   = (15, 20)
	fc   = (9, 14)
	Cr   = (9, 14)
	Csub = (9, 14)

	# Bits of A, B and C, for patterns that exclude the immediate indicators 61-63. SLEIGH expands a
	# range constraint such as (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb1=0 & Bb0=0)) into one pattern per value, and the products of those
	# expansions made the decision tree explode (a 143 MB .sla that Ghidra failed to load);
	# these fields express the same sets as a few disjoint bit patterns.
	At  = (23, 26)
	Ab5 = (26, 26)
	Ab4 = (25, 25)
	Ab3 = (24, 24)
	Ab1 = (22, 22)
	Ab0 = (21, 21)
	Bt  = (17, 20)
	Bb5 = (20, 20)
	Bb4 = (19, 19)
	Bb3 = (18, 18)
	Bb1 = (16, 16)
	Bb0 = (15, 15)
	Ct  = (11, 14)
	Cb5 = (14, 14)
	Cb4 = (13, 13)
	Cb3 = (12, 12)
	Cb1 = (10, 10)
	Cb0 = (9, 9)
	D    = (0, 8) signed
	D2   = (0, 8) signed
	Du   = (0, 8)
	F    = (8, 8)
	Nul  = (5, 6)
	Q    = (0, 4)
	L    = (7, 26) signed
	cjl  = (9, 9)

	# LD, register + register form (I=0): bits 5..0
	lg_Di = (5, 5)
	lg_A  = (3, 3)
	lg_Z  = (1, 2)
	lg_X  = (0, 0)

	# LD, register + offset form and LR (I=1): the C field
	ls_Di = (14, 14)
	ls_LR = (13, 13)
	ls_A  = (12, 12)
	ls_Z  = (10, 11)
	ls_X  = (9, 9)

	# ST and SR (I=2): the A field
	st_Di = (26, 26)
	st_SR = (25, 25)
	st_A  = (24, 24)
	st_Z  = (22, 23)
;

define token limmtok(32)
	limm = (0, 31)
	limm2 = (0, 31)
;

attach variables [ A B fc ] [
	 r0  r1  r2  r3  r4  r5  r6  r7  r8  r9 r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25  gp  fp  sp ilink1 ilink2 blink
	r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47
	r48 r49 r50 r51 r52 r53 r54 r55 r56 r57 r58 r59 lp_count r61 r62 r63
];

attach names [ Csub ] [
	extsop00 extsop01 extsop02 extsop03 extsop04 extsop05 extsop06 extsop07
	extsop08 extsop09 extsop0a extsop0b extsop0c extsop0d extsop0e extsop0f
	extsop10 extsop11 extsop12 extsop13 extsop14 extsop15 extsop16 extsop17
	extsop18 extsop19 extsop1a extsop1b extsop1c extsop1d extsop1e extsop1f
	extsop20 extsop21 extsop22 extsop23 extsop24 extsop25 extsop26 extsop27
	extsop28 extsop29 extsop2a extsop2b extsop2c extsop2d extsop2e extsop2f
	extsop30 extsop31 extsop32 extsop33 extsop34 extsop35 extsop36 extsop37
	extsop38 extsop39 extsop3a extsop3b extsop3c extsop3d extsop3e extsop3f
];

define pcodeop brk;
define pcodeop sleep;
define pcodeop swi;
define pcodeop ext_condition;    # extension condition codes 0x10-0x1f (core specific)
define pcodeop ext_instruction;  # extension instructions (core specific)

# ---------------------------------------------------------------------------------------------
# Operands

# Destination: a core register, or a discarded result when A holds an immediate indicator
dst: A     is (Ab5=0 | (Ab5=1 & Ab4=0) | (Ab5=1 & Ab4=1 & Ab3=0) | At=14 | (At=15 & Ab1=0 & Ab0=0)) & A    { export A; }
dst: "0"   is (At=15 & (Ab1=1 | (Ab1=0 & Ab0=1)))       { export discard; }

# Source operands: register, short immediate (61/63, the 9-bit signed D field) or long immediate
srcB: B      is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb1=0 & Bb0=0)) & B         { export B; }
srcB: D      is (Br=61 | Br=63) & D { export *[const]:4 D; }
srcB: limm   is Br=62; limm       { export *[const]:4 limm; }
srcC: fc      is (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb1=0 & Cb0=0)) & fc         { export fc; }
srcC: D      is (Cr=61 | Cr=63) & D { export *[const]:4 D; }
srcC: limm   is Cr=62; limm       { export *[const]:4 limm; }

# add/adc/and with equal B and C fields are shown as asl/rlc/mov a,b (objdump)

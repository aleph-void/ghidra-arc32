# Condition codes (Q). Short-immediate instructions cannot be conditional: D overlays Q, F, N.
Qcc: "z"   is Q=0x01 { export Z; }
Qcc: "nz"  is Q=0x02 { local t:1 = !Z; export t; }
Qcc: "p"   is Q=0x03 { local t:1 = !N; export t; }
Qcc: "n"   is Q=0x04 { export N; }
Qcc: "c"   is Q=0x05 { export C; }
Qcc: "nc"  is Q=0x06 { local t:1 = !C; export t; }
Qcc: "v"   is Q=0x07 { export V; }
Qcc: "nv"  is Q=0x08 { local t:1 = !V; export t; }
Qcc: "gt"  is Q=0x09 { local t:1 = (N == V) && !Z; export t; }
Qcc: "ge"  is Q=0x0a { local t:1 = (N == V); export t; }
Qcc: "lt"  is Q=0x0b { local t:1 = (N != V); export t; }
Qcc: "le"  is Q=0x0c { local t:1 = Z || (N != V); export t; }
Qcc: "hi"  is Q=0x0d { local t:1 = !C && !Z; export t; }
Qcc: "ls"  is Q=0x0e { local t:1 = C || Z; export t; }
Qcc: "pnz" is Q=0x0f { local t:1 = !N && !Z; export t; }
Qcc: "x10" is Q=0x10 { local t:1 = ext_condition(0x10:1); export t; }
Qcc: "x11" is Q=0x11 { local t:1 = ext_condition(0x11:1); export t; }
Qcc: "x12" is Q=0x12 { local t:1 = ext_condition(0x12:1); export t; }
Qcc: "x13" is Q=0x13 { local t:1 = ext_condition(0x13:1); export t; }
Qcc: "x14" is Q=0x14 { local t:1 = ext_condition(0x14:1); export t; }
Qcc: "x15" is Q=0x15 { local t:1 = ext_condition(0x15:1); export t; }
Qcc: "x16" is Q=0x16 { local t:1 = ext_condition(0x16:1); export t; }
Qcc: "x17" is Q=0x17 { local t:1 = ext_condition(0x17:1); export t; }
Qcc: "x18" is Q=0x18 { local t:1 = ext_condition(0x18:1); export t; }
Qcc: "x19" is Q=0x19 { local t:1 = ext_condition(0x19:1); export t; }
Qcc: "x1a" is Q=0x1a { local t:1 = ext_condition(0x1a:1); export t; }
Qcc: "x1b" is Q=0x1b { local t:1 = ext_condition(0x1b:1); export t; }
Qcc: "x1c" is Q=0x1c { local t:1 = ext_condition(0x1c:1); export t; }
Qcc: "x1d" is Q=0x1d { local t:1 = ext_condition(0x1d:1); export t; }
Qcc: "x1e" is Q=0x1e { local t:1 = ext_condition(0x1e:1); export t; }
Qcc: "x1f" is Q=0x1f { local t:1 = ext_condition(0x1f:1); export t; }

# Delay-slot field of ALU instructions (meaningless; shown as objdump does)
ndx: ""    is Br=61 | Br=63 | Cr=61 | Cr=63 {}
ndx: ""    is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb0=0)) & (Nul=0 | Nul=3) {}
ndx: ".d"  is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb0=0)) & Nul=1 {}
ndx: ".jd" is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb0=0)) & Nul=2 {}

# ---------------------------------------------------------------------------------------------
# Flag helpers

macro zn(res) {
	Z = (res == 0);
	N = (res s< 0);
}

macro addflags(a, b, res) {
	zn(res);
	C = carry(a, b);
	V = scarry(a, b);
}

macro subflags(a, b, res) {
	zn(res);
	C = a < b;
	V = sborrow(a, b);
}

# STATUS register: Z N C V E2 E1 H in bits 31..25, PC[25:2] in bits 23..0
macro getstatus(res, pcval) {
	res = (zext(Z) << 31) | (zext(N) << 30) | (zext(C) << 29) | (zext(V) << 28) |
		(zext(E2) << 27) | (zext(E1) << 26) | (zext(H) << 25) | ((pcval >> 2) & 0xffffff);
}

# J.F: flags (not H) from bits 31..26 of the operand
macro jflags(val) {
	Z  = (val & 0x80000000) != 0;
	N  = (val & 0x40000000) != 0;
	C  = (val & 0x20000000) != 0;
	V  = (val & 0x10000000) != 0;
	E2 = (val & 0x08000000) != 0;
	E1 = (val & 0x04000000) != 0;
}

# ---------------------------------------------------------------------------------------------
# Zero-overhead loop: the instruction at LP_END (marked through the loopEnd context by "lp")
# first branches back to LP_START while LP_COUNT (24 bits) has not reached 0.
lpstart: addr is loopStart [ addr = loopStart << 2; ] { export *[ram]:4 addr; }

:^instruction is phase=0 & instruction [ phase = 1; ] {
	build instruction;
}
:^instruction is phase=0 & loopEnd=1 & lpstart & instruction [ phase = 1; ] {
	if (is_in_loop == 0) goto <end_loop>;
	lp_count = (lp_count - 1) & 0xffffff;
	if (lp_count == 0) goto <end_loop>;
	goto lpstart;
<end_loop>
	is_in_loop = 0;
	build instruction;
}

with : phase=1 {

# Branch targets: PC + 4 + 4*L, within the 26-bit program counter
reltarget: addr is L [ addr = (inst_next + L * 4) & 0x3ffffff; ] { export *[ram]:4 addr; }
# Address of the instruction after the delay slot (nullified delay slot)
skipnext: addr is epsilon [ addr = inst_next2; ] { export *[ram]:4 addr; }
link2: addr is epsilon [ addr = inst_next2; ] { export *[const]:4 addr; }

# ---------------------------------------------------------------------------------------------
# Operands of the generated instructions (ARC32_ops.sinc)

# User extension instructions (0x16-0x1d)
extmaj: "ext16" is I=0x16 { export 0x16:1; } extmaj: "ext17" is I=0x17 { export 0x17:1; } extmaj: "ext18" is I=0x18 { export 0x18:1; }
extmaj: "ext19" is I=0x19 { export 0x19:1; } extmaj: "ext1a" is I=0x1a { export 0x1a:1; } extmaj: "ext1b" is I=0x1b { export 0x1b:1; }
extmaj: "ext1c" is I=0x1c { export 0x1c:1; } extmaj: "ext1d" is I=0x1d { export 0x1d:1; }

# Source of a single-operand instruction (the C field holds the sub-opcode)
src1: B     is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb1=0 & Bb0=0)) & B          { export B; }
src1: D     is (Br=61 | Br=63) & D { export *[const]:4 D; }
src1: limm  is Br=62; limm        { export *[const]:4 limm; }
nd1: ""    is Br=61 | Br=63 {}
nd1: ""    is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & (Nul=0 | Nul=3) {}
nd1: ".d"  is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & Nul=1 {}
nd1: ".jd" is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & Nul=2 {}

# FLAG: Z N C V E2 E1 H from bits 6..0 of the operand; when H is set the other flags are kept
macro setflags(val) {
	local v:4 = val;
	local h:1 = (v & 1) != 0;
	Z  = (h && Z) || (!h && ((v & 0x40) != 0));
	N  = (h && N) || (!h && ((v & 0x20) != 0));
	C  = (h && C) || (!h && ((v & 0x10) != 0));
	V  = (h && V) || (!h && ((v & 0x08) != 0));
	E2 = (h && E2) || (!h && ((v & 0x04) != 0));
	E1 = (h && E1) || (!h && ((v & 0x02) != 0));
	H  = h;
}

macro lpsetup(endaddr) {
	*[auxregs]:4 2:4 = inst_next >> 2;
	*[auxregs]:4 3:4 = endaddr >> 2;
	is_in_loop = 1;
}

# j [b] / jl [b]
jreg: "["^B^"]" is B { export B; }
jnd: "" is Nul=0 | Nul=3 {}
jnd: ".d" is Nul=1 {}
jnd: ".jd" is cjl=0 & Nul=2 {}
jnd: ""    is cjl=1 & Nul=2 {}   # JD is the required mode of jl to a long immediate
jlimm: addr is limm [ addr = (limm & 0xffffff) << 2; ] { export *[ram]:4 addr; }
jshimm: addr is D [ addr = (D & 0xffffff) << 2; ] { export *[ram]:4 addr; }

# ---------------------------------------------------------------------------------------------
# Loads and stores. Sizes: 0 long word, 1 byte, 2 word (3 is reserved); .x sign-extends,
# .a writes the address back to a base register, .di bypasses the data cache.

lgdi: "" is lg_Di=0 {} lgdi: ".di" is lg_Di=1 {}
lsdi: "" is ls_Di=0 {} lsdi: ".di" is ls_Di=1 {}
stdi: "" is st_Di=0 {} stdi: ".di" is st_Di=1 {}
# register + register loads: the C field decides when it holds a short immediate (as for ALU ops)
ldfg: ".f" is Cr=61 {}
ldfg: ""   is Cr=63 {}
ldfg: ".f" is Br=61 & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb0=0)) {}
ldfg: ""   is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & (Bb1=1 | (Bb1=0 & Bb0=0)))) & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb0=0)) {}
# lr: objdump shows ".f" for the flag-setting short-immediate indicator 61 (it has no effect)
ldfs: ".f" is Br=61 {}
ldfs: ""   is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & (Bb1=1 | (Bb1=0 & Bb0=0)))) {}

# Effective address of the register + register form (I=0)
lgaddr: "["^B^","^srcC^"]"  is ((Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb1=0 & Bb0=0)) & B) ... & srcC ... { local ea:4 = B + srcC; export ea; }
lgaddr: "["^fc^"]"           is (Br=61 | Br=63) & D=0 & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb1=0 & Cb0=0)) & fc { export fc; }
lgaddr: "["^D^","^fc^"]"     is (Br=61 | Br=63) & D & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb1=0 & Cb0=0)) & fc   { local ea:4 = D + fc; export ea; }
lgaddr: "["^D^","^D2^"]"    is (Br=61 | Br=63) & D & D2 & (Cr=61 | Cr=63) { local ea:4 = D + D; export ea; }
lgaddr: "[0]"               is (Br=61 | Br=63) & D=0 & (Cr=61 | Cr=63) { export 0:4; }
lgaddr: "["^limm^"]"           is (Br=61 | Br=63) & D=0 & Cr=62; limm { export *[const]:4 limm; }
lgaddr: "["^D^","^limm^"]"    is (Br=61 | Br=63) & D & Cr=62; limm { local ea:4 = D + limm; export ea; }
lgaddr: "["^limm^","^fc^"]"  is Br=62 & (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb1=0 & Cb0=0)) & fc; limm            { local ea:4 = limm + fc; export ea; }
lgaddr: "["^limm^","^D^"]"  is Br=62 & D & (Cr=61 | Cr=63); limm   { local ea:4 = limm + D; export ea; }
lgaddr: "["^limm^","^limm2^"]" is Br=62 & Cr=62; limm & limm2               { local ea:4 = limm + limm; export ea; }

# Effective address of the register + offset forms (LD I=1, ST I=2): b + D
lsaddr: "["^B^"]"          is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb1=0 & Bb0=0)) & B & D=0   { export B; }
lsaddr: "["^B^","^D^"]"    is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb1=0 & Bb0=0)) & B & D     { local ea:4 = B + D; export ea; }
lsaddr: "["^ea^"]"         is (Br=61 | Br=63) & D [ ea = D + D; ] { export *[const]:4 ea; }
lsaddr: "["^ea^"]"         is Br=62 & D; limm [ ea = (limm + D) & 0xffffffff; ] { export *[const]:4 ea; }

# Store data: c, short immediate or long immediate
stdata: fc     is (Cb5=0 | (Cb5=1 & Cb4=0) | (Cb5=1 & Cb4=1 & Cb3=0) | Ct=14 | (Ct=15 & Cb1=0 & Cb0=0)) & fc          { export fc; }
stdata: D     is (Cr=61 | Cr=63) & D { export *[const]:4 D; }
stdata: limm  is Cr=62; limm        { export *[const]:4 limm; }

@include "ARC32_ops.sinc"

# Sub-opcode 0x3f: BRK, SLEEP, SWI selected by the short-immediate field
:brk   is I=0x03 & Cr=0x3f & D=0 { brk(); }
:sleep is I=0x03 & Cr=0x3f & D=1 { sleep(); }
:swi   is I=0x03 & Cr=0x3f & D=2 { swi(); }

# xor 0,-1,-1 (0x7fffffff) is the NOP of the manual and of objdump
:nop is I=0x0f & Ar=63 & Br=63 & Cr=63 & Du=0x1ff { }

# ---------------------------------------------------------------------------------------------
# Auxiliary registers: lr a,[b] (I=1, bit 13) and sr c,[b] (I=2, bit 25). The register number
# is operand b (register, short or long immediate). Reading STATUS returns the flags and the
# address of the next instruction.

auxnum: "status"    is (Br=61 | Br=63) & D=0 { export 0:4; }
auxnum: "semaphore" is (Br=61 | Br=63) & D=1 { export 1:4; }
auxnum: "lp_start"  is (Br=61 | Br=63) & D=2 { export 2:4; }
auxnum: "lp_end"    is (Br=61 | Br=63) & D=3 { export 3:4; }
auxnum: "identity"  is (Br=61 | Br=63) & D=4 { export 4:4; }
auxnum: "debug"     is (Br=61 | Br=63) & D=5 { export 5:4; }
auxnum: n           is (Br=61 | Br=63) & D [ n = D & 0xffffffff; ] { export *[const]:4 n; }
auxnum: limm        is Br=62; limm { export *[const]:4 limm; }
auxnum: B           is (Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb1=0 & Bb0=0)) & B { export B; }

:lr^ldfs dst, "["^auxnum^"]" is (I=0x01 & ls_LR=1 & ldfs & dst) ... & auxnum ... {
	dst = *[auxregs]:4 auxnum;
}
:lr^ldfs dst, "[status]" is I=0x01 & ls_LR=1 & ldfs & dst & (Br=61 | Br=63) & D=0 {
	local s:4; getstatus(s, inst_next);
	dst = s;
}
:sr^ldfg stdata, "["^auxnum^"]" is (I=0x02 & st_SR=1 & ldfg) ... & stdata ... & auxnum ... {
	*[auxregs]:4 auxnum = stdata;
}
# Writing LP_END activates the loop mechanism (a loop set up with SR rather than LP; the loop end
# is marked by the Arc32LoopAnalyzer when the address is a constant)
:sr^ldfg stdata, "[lp_end]" is (I=0x02 & st_SR=1 & ldfg & (Br=61 | Br=63) & D=3) ... & stdata ... {
	*[auxregs]:4 3:4 = stdata;
	is_in_loop = 1;
}

} # end of "with : phase=1"

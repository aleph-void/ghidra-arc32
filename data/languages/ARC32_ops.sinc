# ---------------------------------------------------------------------------------------------
# Branch, branch and link, loop set-up: op<cc><.dd> rel_addr. The delay-slot mode: ND executes the
# next instruction only when not branching, D always, JD only when branching (a nullified delay
# slot continues after it; BL/JL link to the instruction after the delay slot for D and JD).

:b reltarget is I=0x04 & Q=0 & reltarget & (Nul=0 | Nul=3) {
	goto reltarget;
}
:b^Qcc reltarget is I=0x04 & Qcc & reltarget & (Nul=0 | Nul=3) {
	if (Qcc) goto reltarget;
}
:b^".d" reltarget is I=0x04 & Q=0 & reltarget & Nul=1 {
	delayslot(1);
	goto reltarget;
}
:b^Qcc^".d" reltarget is I=0x04 & Qcc & reltarget & Nul=1 {
	local c:1 = Qcc;
	delayslot(1);
	if (c) goto reltarget;
}
:b^".jd" reltarget is I=0x04 & Q=0 & reltarget & Nul=2 {
	delayslot(1);
	goto reltarget;
}
:b^Qcc^".jd" reltarget is I=0x04 & Qcc & reltarget & Nul=2 & skipnext {
	if (!Qcc) goto skipnext;
	delayslot(1);
	goto reltarget;
}

:bl reltarget is I=0x05 & Q=0 & reltarget & (Nul=0 | Nul=3) {
	local s:4; getstatus(s, inst_next);
	blink = s;
	call reltarget;
}
:bl^Qcc reltarget is I=0x05 & Qcc & reltarget & (Nul=0 | Nul=3) {
	if (!Qcc) goto <skip>;
	local s:4; getstatus(s, inst_next);
	blink = s;
	call reltarget;
<skip>
}
:bl^".d" reltarget is link2 & I=0x05 & Q=0 & reltarget & Nul=1 {
	local s:4; getstatus(s, link2);
	delayslot(1);
	blink = s;
	call reltarget;
}
:bl^Qcc^".d" reltarget is link2 & I=0x05 & Qcc & reltarget & Nul=1 {
	local c:1 = Qcc;
	local s:4; getstatus(s, link2);
	delayslot(1);
	if (!c) goto <skip>;
	blink = s;
	call reltarget;
<skip>
}
:bl^".jd" reltarget is link2 & I=0x05 & Q=0 & reltarget & Nul=2 {
	local s:4; getstatus(s, link2);
	delayslot(1);
	blink = s;
	call reltarget;
}
:bl^Qcc^".jd" reltarget is link2 & I=0x05 & Qcc & reltarget & Nul=2 & skipnext {
	if (!Qcc) goto skipnext;
	local s:4; getstatus(s, link2);
	delayslot(1);
	blink = s;
	call reltarget;
}

# LP: when the condition holds, LP_START = next instruction, LP_END = target (both as PC/4),
# otherwise branch to the target.
:lp reltarget is I=0x06 & Q=0 & reltarget & (Nul=0 | Nul=3)
	[ loopEnd = 1; globalset(reltarget, loopEnd); loopStart = (inst_start + 4) >> 2; globalset(reltarget, loopStart); ] {
	lpsetup(&reltarget);
}
:lp^Qcc reltarget is I=0x06 & Qcc & reltarget & (Nul=0 | Nul=3)
	[ loopEnd = 1; globalset(reltarget, loopEnd); loopStart = (inst_start + 4) >> 2; globalset(reltarget, loopStart); ] {
	if (!Qcc) goto reltarget;
	lpsetup(&reltarget);
}
:lp^".d" reltarget is I=0x06 & Q=0 & reltarget & Nul=1
	[ loopEnd = 1; globalset(reltarget, loopEnd); loopStart = (inst_start + 4) >> 2; globalset(reltarget, loopStart); ] {
	delayslot(1);
	lpsetup(&reltarget);
}
:lp^Qcc^".d" reltarget is I=0x06 & Qcc & reltarget & Nul=1
	[ loopEnd = 1; globalset(reltarget, loopEnd); loopStart = (inst_start + 4) >> 2; globalset(reltarget, loopStart); ] {
	local c:1 = Qcc;
	delayslot(1);
	if (!c) goto reltarget;
	lpsetup(&reltarget);
}
:lp^".jd" reltarget is I=0x06 & Q=0 & reltarget & Nul=2 & skipnext
	[ loopEnd = 1; globalset(reltarget, loopEnd); loopStart = (inst_start + 4) >> 2; globalset(reltarget, loopStart); ] {
	lpsetup(&reltarget);
	goto skipnext;
}
:lp^Qcc^".jd" reltarget is I=0x06 & Qcc & reltarget & Nul=2 & skipnext
	[ loopEnd = 1; globalset(reltarget, loopEnd); loopStart = (inst_start + 4) >> 2; globalset(reltarget, loopStart); ] {
	if (Qcc) goto <setup>;
	delayslot(1);
	goto reltarget;
<setup>
	lpsetup(&reltarget);
	goto skipnext;
}


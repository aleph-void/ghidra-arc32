:norm^nd1 dst, src1 is (I=0x03 & Cr=0x0a & dst & nd1 & (Br=63 | ((Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & Q=0 & F=0))) ... & src1 ... {
	local a:4 = src1; local r:4;
	local x:4 = a ^ (a s>> 31); r = lzcount(x) - 1;
	dst = r;
}

# and are not decoded)
:^Csub^".f"^nd1 dst, src1 is (I=0x03 & Cr>=0x0b & Cr<=0x3c & Csub & dst & nd1 & (Br=61 | ((Bb5=0 | (Bb5=1 & Bb4=0) | (Bb5=1 & Bb4=1 & Bb3=0) | Bt=14 | (Bt=15 & Bb0=0)) & Q=0 & F=1))) ... & src1 ... {
	dst = ext_instruction(0x03:1, Csub:1, src1, 1:1);
